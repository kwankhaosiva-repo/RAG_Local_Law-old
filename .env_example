# ===== Thai Law RAG Chatbot — Environment Configuration =====
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามที่ใช้จริง:  cp .env_example .env

# --- LLM Provider ---
# ollama (local, default) | openai | anthropic | google | openrouter
LLM_PROVIDER=ollama

# Ollama (local)
OLLAMA_HOST=http://localhost:11434
LLM_MODEL_NAME=llama3.2
# Dev test mode: รัน python src/test_local.py เพื่อทดสอบด้วย Ollama local ก่อน deploy
# ไม่ต้องมี LINE/Discord/cloud API key — ทดสอบได้ทั้ง agent, retriever, multi-turn, intent routing

# OpenAI (gpt-4o-mini ราคาถูกและเร็ว — แนะนำสำหรับ deploy บน cloud)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Google Gemini
# LLM_PROVIDER=google
# GOOGLE_API_KEY=...
# GOOGLE_MODEL=gemini-2.0-flash

# OpenRouter (gateway หลายโมเดลใน key เดียว)
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Groq (เร็วมาก ฟรี tier)
# LLM_PROVIDER=groq
# GROQ_API=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# Mistral (มี free tier)
# LLM_PROVIDER=mistral
# MISTRAL_API=...
# MISTRAL_MODEL=mistral-small-latest

# Cloudflare Workers AI (ต้องใส่ ACCOUNT_ID ด้วย)
# LLM_PROVIDER=cloudflare
# CLOUDFLARE_API=...
# CLOUDFLARE_ACCOUNT_ID=...
# CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Embedding model (HuggingFace multilingual)
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Server ---
# PORT ใช้โดย Cloud Run อัตโนมัติ (default 8000 ตอนรัน local)
PORT=8000
API_HOST=0.0.0.0

# --- LINE Messaging API (Optional Channel) ---
# จาก https://developers.line.biz/console/ → Messaging API channel
# LINE_CHANNEL_ACCESS_TOKEN=...
# LINE_CHANNEL_SECRET=...

# --- Discord Bot (Optional Channel) ---
# จาก https://discord.com/developers/applications → Bot → Token
# DISCORD_BOT_TOKEN=...

# --- OpenClaw Gateway Webhook (Optional Channel) ---
# secret สำหรับ header "X-OpenClaw-Secret" ที่ OpenClaw gateway ต้องส่งมาด้วย (เว้นว่าง = ไม่ตรวจ)
OPENCLAW_SECRET=change-me

# --- GCS chroma_db snapshot (โหลดแบบ background บน Cloud Run ผ่าน src/db_sync.py) ---
# bucket ที่เก็บ chroma_db ไว้ (ต้อง upload ทั้งโฟลเดอร์ chroma_db ไว้ใน bucket นี้แล้ว)
GCS_CHROMA_BUCKET=gs://chroma-db-law
# prefix ภายใน bucket (default: chroma_db)
GCS_CHROMA_PREFIX=chroma_db

# --- Firestore (ประวัติแชท / ข้อมูลผู้ใช้) ---
# ใช้ database "rag-law-db" ใน project rag-law-509304 (local ไม่มี auth จะข้ามอัตโนมัติ)
GCP_PROJECT_ID=rag-law-509304
FIRESTORE_DB=rag-law-db
FIRESTORE_CHAT_COLLECTION=chat_sessions

# --- BigQuery analytics (log คำถาม/คำตอบ ไว้วิเคราะห์) ---
BIGQUERY_DATASET=rag_law_query
BIGQUERY_TABLE=queries

# --- Ratchakitcha Crawler ---
# จำนวนรายการต่อ 1 หน้าจาก api.soc.go.th
CRAWLER_PAGE_LIMIT=50
# Token จำเป็น! สมัคร/เข้าสู่ระบบรับได้ที่ https://www2.soc.go.th แล้วใส่ตรงนี้
# RATCHAKITCHA_TOKEN=...
